{
  "name": "@howaboua/opencode-chat",
  "version": "0.1.10",
  "description": "Chatifier plugin for OpenCode - Adds chat-optimized tools and semantic search",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-chat-download-model": "dist/script/download-model.js",
    "opencode-chat-semantic-index": "dist/script/semantic-index.js"
  },
  "author": "Igor Warzocha",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "postclean": "bun run clean:bundle",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "download-model": "bun dist/script/download-model.js",
    "semantic-index": "bun dist/script/semantic-index.js",
    "bundle": "bun build index.ts --target=bun --outdir=plugin/opencode-chat",
    "postbundle": "bun hack/prepare-local-plugin.ts",
    "clean:bundle": "rm -rf plugin/opencode-chat"
  },
  "dependencies": {
    "fastembed": "latest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.0.201"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.201",
    "@types/node": "^20.0.0",
    "bun-types": "latest",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "chat",
    "semantic-search",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorWarzocha/Opencode-Chatifier.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
